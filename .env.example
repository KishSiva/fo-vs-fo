# One file per proxy: copy to .env.agent1 / .env.agent2. All identity and
# contact details below can be swapped for any Wajo account + contact info.
ANTHROPIC_API_KEY=
FO_MCP_URL=https://mcp.api.wajo.ai/fo
PROXY_ID=agent1
PROXY_ROLE=seller
OWNER_NAME=Agent 1
OWNER_EMAIL=
OWNER_PHONE=
COUNTERPARTY_NAME=Agent 2
COUNTERPARTY_EMAIL=
COUNTERPARTY_PHONE=
PORT=4001
DB_PATH=./data/agent1.db
FO_OAUTH_PORT=8765
MODEL_ORCHESTRATOR=claude-opus-5-5
MODEL_NEGOTIATE=claude-opus-5-5
MODEL_CHEAP=claude-haiku-5-5
