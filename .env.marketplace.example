# Marketplace mode: ONE proxy (Claude drives, Fo acts) negotiating with a real person by text or call.
# Copy to .env.marketplace and fill in. Run: pnpm marketplace (real Fo) or pnpm marketplace:mock (rehearsal).
ANTHROPIC_API_KEY=
FO_MCP_URL=https://mcp.api.wajo.ai/fo
PROXY_ID=marketplace
# Our agent plays the buyer; the seller is a teammate texting from their own phone.
PROXY_ROLE=buyer
OWNER_NAME=Dev
# The Fo account's own phone number and email (the number the seller sees texts from).
OWNER_PHONE=+15550000001
OWNER_EMAIL=
# The owner's personal cell: Fo texts it for YES/NO sign-off before any deal is final.
OWNER_NOTIFY_PHONE=+15550000002
# Default seller contact; the Marketplace page asks for the real name and number per deal.
COUNTERPARTY_NAME=the seller
COUNTERPARTY_PHONE=
COUNTERPARTY_EMAIL=
PORT=4001
DB_PATH=./data/marketplace.db
FO_OAUTH_PORT=8765
MODEL_ORCHESTRATOR=claude-opus-5-5
MODEL_NEGOTIATE=claude-opus-5-5
MODEL_CHEAP=claude-haiku-4-5-20251001
PROMPT_CACHE_TTL=1h
# Check Fo for new texts every 10s (each reply starts a Claude turn).
INBOUND_POLL_MS=10000
WORKER_INTERVAL_MS=3000
# No peer proxy in marketplace mode.
PEER_PROXY_URL=
# Fo never moves money unless this is 1. Leave it at 0 for the demo.
ALLOW_PAYMENTS=0
